# copy to /root/osh-bot.env  (chmod 600). Never commit real values.
BOT_TOKEN=123456:ABC...
ADMIN_IDS=111111111
DATA_DIR=/var/lib/opensea-hunter
MASTER_KEY_FILE=/root/osh-master.key
PRICE_STARS=500
SUB_DAYS=30
MAX_ACTIVE_TASKS=3
SPAWN_BEFORE_S=7200
# https URL where keypage/index.html is served (GitHub Pages / any static host). Optional.
KEYPAGE_URL=
